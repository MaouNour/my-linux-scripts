#!/usr/bin/env python3
"""pview – open HTML/URL in a frameless pywebview window."""
import sys
import webview

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <file.html | url>")
        sys.exit(1)

    target = sys.argv[1]
    webview.create_window(
        "pview",
        target,
        width=1200,
        height=800,
        frameless=True,
        menu=[],
    )
    webview.start(private_mode=False)


if __name__ == "__main__":
    main()   
