#!/usr/bin/env python3
import sys
import os
import sqlite3
import argparse
import tempfile
import webview

CONFIG_DIR = os.path.expanduser("~/.config/pyview")
STATE_FILE = os.path.join(CONFIG_DIR, "last_url")
HISTORY_DB = os.path.join(CONFIG_DIR, "history.db")


def connect_db():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    return sqlite3.connect(HISTORY_DB)


def save_url(url):
    if not url:
        return

    os.makedirs(CONFIG_DIR, exist_ok=True)

    with open(STATE_FILE, "w") as f:
        f.write(url)

    with connect_db() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS history (
                id INTEGER PRIMARY KEY,
                url TEXT NOT NULL,
                visited DATETIME DEFAULT CURRENT_TIMESTAMP
            )
        """)
        db.execute("INSERT INTO history (url) VALUES (?)", (url,))


def load_url():
    try:
        with open(STATE_FILE) as f:
            return f.read().strip()
    except FileNotFoundError:
        return None


def show_history():
    if not os.path.exists(HISTORY_DB):
        print("No history found.")
        return

    with connect_db() as db:
        rows = db.execute(
            "SELECT url, visited FROM history ORDER BY id DESC"
        ).fetchall()

    for url, visited in rows:
        print(f"{visited}  {url}")


def clear_history():
    if os.path.exists(HISTORY_DB):
        with connect_db() as db:
            db.execute("DROP TABLE IF EXISTS history")

    print("History cleared.")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "history":
        if "--clear" in sys.argv:
            clear_history()
        else:
            show_history()
        return

    parser = argparse.ArgumentParser(prog="pyview")

    parser.add_argument("url", nargs="?")
    parser.add_argument("-p", "--private", action="store_true")

    args = parser.parse_args()

    target = args.url or load_url()

    if not target:
        parser.print_help()
        return

    window = webview.create_window(
        "pyview",
        target,
        width=1200,
        height=800,
        frameless=True,
        menu=[],
    )

    if not args.private:
        window.events.loaded += lambda: save_url(window.get_current_url())

    webview.start(private_mode=args.private)


if __name__ == "__main__":
    main()

