#!/usr/bin/env bash

#set -euo pipefail

FTP_PORT=2121

get_neighbors() {
  ip -4 neigh |
    awk '$NF != "FAILED" {print $1}' |
    sort -u
}

has_ftp() {
  local ip="$1"

  timeout 0.5 bash -c \
    "echo >/dev/tcp/$ip/$FTP_PORT" \
    &>/dev/null
}

find_ftp_hosts() {
  local ip

  while read -r ip; do
    has_ftp "$ip" && echo "$ip"
  done
}

choose_hosts() {
  gum choose --no-limit
}

open_hosts() {
  local ip

  while read -r ip; do
    if [ -z "$FTP_DEFAULT_APP" ]; then
      xdg-open "ftp://$ip:$FTP_PORT" &
    else
      "$FTP_DEFAULT_APP" "ftp://$ip:$FTP_PORT" &>/dev/null &
    fi
  done
}

main() {
  local ftp_hosts

  ftp_hosts="$(get_neighbors | find_ftp_hosts || true)"

  if [[ -z $ftp_hosts ]]; then
    echo "No FTP hosts found."
    return 1
  fi
  local next=false
  for arg in "$@"; do
    if [ "$next" = true ]; then
      export FTP_DEFAULT_APP="$arg"
    fi
    if [ "$arg" = "--ftp-app" ]; then
      next=true
    fi
  done

  printf '%s\n' "$ftp_hosts" |
    choose_hosts |
    open_hosts
}
main "$@"
