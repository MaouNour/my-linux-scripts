#!/bin/bash
title=""
icon=""
command=""
if [ "$(virsh domstate RDPWindows)" == "running" ]; then
  title="stop"
  icon="🟢"
  command="virsh shutdown RDPWindows"
else
  title="start"
  icon="🔴"
  command="virsh start RDPWindows"
fi
echo "{\"title\":\"$title\",\"icon\":\"$icon\",\"command\":\"$command\"}"
