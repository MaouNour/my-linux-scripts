#!/bin/bash
proton="$1"
game="$2"
export SteamAppId=3483510
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/$SteamAppId"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
game-performance gamemoderun "$HOME/.local/share/Steam/compatibilitytools.d/$proton/proton" run "$game"
