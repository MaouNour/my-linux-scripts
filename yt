#!/bin/bash
res="$1"
url="$2"
if [ -z "$YT_DLP_DEFAULT_RES" ]; then
  YT_DLP_DEFAULT_RES="720"
fi
if [ -z "$res" ]; then
  res=$YT_DLP_DEFAULT_RES
fi
show-help() {
  echo "\
  youtube Videos downloader Script 
  Copyright (c) 2026 MaouNour. All Rights Reserved.
  Usage:
    ytpl <resolution> <url> <yt-dlp options>
  "
}
yt-dlp -f "bestvideo[height<=$res][ext=mp4]+bestaudio/best[height<=$res][ext=m4a]" "${@:4}" "$url"
